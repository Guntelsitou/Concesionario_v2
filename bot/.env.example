# WhatsApp Business Cloud API (Meta)
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=replace-with-a-long-random-secret
WA_APP_SECRET=replace-with-meta-app-secret
# Ajusta la versión al producto Meta habilitado en tu app.
WA_API_BASE=https://graph.facebook.com/v26.0

# Lista permitida; formato: telefono:Nombre,telefono:Nombre
WORKERS=34611111111:Manolo,34622222222:Manuel

# Token aleatorio largo para editar el inventario desde /admin.html
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token

# Rutas; por defecto apuntan a web/ y bot/data/ del proyecto
WEB_DIR=../web
DATA_DIR=./data
WEB_URL=https://www.example.com
GIT_PUSH=false
AUTO_SEGUNDOS=10
SESION_HORAS=12

# Negocio (garantía no se inventa: configura lo que ofrecéis)
NEGOCIO_NOMBRE=Mi concesionario
NEGOCIO_TEL=600000000
NEGOCIO_CIUDAD=Madrid
GARANTIA_TXT=Garantía según condiciones del concesionario

# Instagram: opcional, deja vacío para desactivarlo
IG_TOKEN=
IG_USER_ID=
IG_API_BASE=https://graph.facebook.com/v26.0

# Redacción con Claude: opcional
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
